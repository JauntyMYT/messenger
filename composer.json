{
    "name": "jauntym/messenger",
    "type": "phpbb-extension",
    "description": "Conversation-style private messages for phpBB — a modern, Messenger-like chat experience with read receipts, typing indicators, BBCode, blocking and an ACP settings panel.",
    "homepage": "https://www.bejaunty.com",
    "version": "1.3.7",
    "time": "2026-06-14",
    "keywords": ["phpbb", "extension", "messenger", "private message", "chat", "pm"],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "JauntyM",
            "homepage": "https://www.bejaunty.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/JauntyMYT/messenger/issues",
        "source": "https://github.com/JauntyMYT/messenger"
    },
    "require": {
        "php": ">=7.2.0"
    },
    "extra": {
        "display-name": "JauntyM Messenger",
        "soft-require": {
            "phpbb/phpbb": ">=3.2.0,<4.0.0@dev"
        }
    }
